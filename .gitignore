firebase-service-account.json
firebase-key.json
.firebaserc

# Testing
/coverage

# Allow project JSON and TS files in src
!src/**/*.ts
!src/**/*.tsx
!src/**/*.json

# Sentry Config File
.env.sentry-build-plugin
