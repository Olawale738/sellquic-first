{
    "hosting": {
      "source": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "frameworksBackend": {
        "region": "us-central1",
        "webFramework": "next"
      }
    },
    "firestore": {
      "database": "(default)",
      "location": "us-central1",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    "storage": {
      "rules": "storage.rules"
    },
    
    "emulators": {
      "hosting": {
        "port": 9003
      }
    }
  }